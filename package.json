{
  "name": "home-base",
  "version": "1.6.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "bump": "node scripts/bump-version.js patch",
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major",
    "build:uat": "npm run bump && eas build --platform ios",
    "build:uat:android": "npm run bump && eas build --platform android",
    "build:store": "npm run bump && eas build --platform ios --profile store",
    "build:store:android": "npm run bump && eas build --platform android --profile store"
  },
  "dependencies": {
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "^58.0.26",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-notifications": "~58.1.9",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.4",
    "@types/uuid": "^9.0.8",
    "typescript": "~6.0.3"
  },
  "private": true
}
